# ============================================
# cellxgene-cafe Development Environment
# ============================================
# Copy this file to .env and fill in your local paths.
# .env is gitignored and will not be committed.

# ---- Required ----

# Absolute path to the cellxgene host source directory
CELLXGENE_SOURCE_ROOT=/path/to/cellxgene

# Conda environment name for the cellxgene Python runtime
CELLXGENE_CONDA_ENV=cellxgene_cafe

# Absolute path to an .h5ad dataset file (AnnData format with cafe trajectory data)
CELLXGENE_DATASET=/path/to/your/dataset.h5ad

# ---- Ports (defaults are usually fine) ----

# Backend server port
CELLXGENE_PORT=5005

# Host frontend dev server port
CXG_CLIENT_PORT=3000

# Plugin frontend dev server port (HMR mode)
CELLXGENE_PLUGIN_DEV_PORT=3001

# ---- Optional ----

# Set to 1 to kill any process occupying CELLXGENE_PORT / CXG_CLIENT_PORT before starting
CELLXGENE_FORCE_KILL_PORT=1

# Explicit Python binary path (if not using conda env resolution)
# CELLXGENE_PYTHON=/usr/bin/python3

# Set to 0 to use a one-time production bundle instead of HMR dev server
# CELLXGENE_PLUGIN_HMR=1

# Gateway control-plane URL (reserved for multi-dataset orchestration)
# CAFE_GATEWAY_URL=http://localhost:7000
